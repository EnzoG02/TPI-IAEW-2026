# Copiar a .env (cp .env.example .env). NO subir .env al repositorio.

# --- API ---
API_PORT=3000

# --- PostgreSQL ---
POSTGRES_USER=biblioteca
POSTGRES_PASSWORD=cambiar_esto
POSTGRES_DB=biblioteca
DATABASE_URL=postgresql://biblioteca:cambiar_esto@db:5432/biblioteca

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_URL=amqp://guest:guest@broker:5672

# --- Auth0 (se usa desde la Entrega 2) ---
AUTH0_DOMAIN=TU_TENANT.us.auth0.com
AUTH0_ISSUER=https://TU_TENANT.us.auth0.com/
AUTH0_AUDIENCE=https://api.biblioteca.local

# --- API key (endpoint de comparación, Entrega 2) ---
API_KEY=dev-api-key-change-me
