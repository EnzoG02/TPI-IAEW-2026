# Copiar a .env (cp .env.example .env). NO subir .env al repositorio.
# Todos los valores son de ejemplo; los de Auth0 se obtienen siguiendo docs/auth0.md.

# --- API ---
API_PORT=3000

# --- PostgreSQL ---
POSTGRES_USER=biblioteca
POSTGRES_PASSWORD=cambiar_esto
POSTGRES_DB=biblioteca
DATABASE_URL=postgresql://biblioteca:cambiar_esto@db:5432/biblioteca

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=biblioteca
RABBITMQ_DEFAULT_PASS=cambiar_esto
RABBITMQ_URL=amqp://biblioteca:cambiar_esto@broker:5672

# --- Auth0 (resource server): lo único que necesita la API ---
AUTH0_DOMAIN=TU_TENANT.us.auth0.com
AUTH0_AUDIENCE=https://api.biblioteca.local

# --- Auth0 (clientes M2M): solo para pruebas y demo (Newman, JMeter, cliente WebSocket) ---
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_LECTOR_CLIENT_ID=
AUTH0_LECTOR_CLIENT_SECRET=

# --- API key (endpoint de comparación /status/api-key) ---
API_KEY=cambiar-esta-api-key

# --- Worker ---
MAX_RETRIES=3
RETRY_DELAY_MS=5000
# >0 hace fallar los primeros N intentos de cada evento para demostrar retry/DLQ
SIMULATE_TRANSIENT_FAILURES=0
VENCIMIENTOS_INTERVAL_MS=60000
MULTA_MONTO=500

# --- Grafana (http://localhost:3001, usuario admin) ---
GRAFANA_ADMIN_PASSWORD=admin
