{
  "name": "biblioteca-api",
  "version": "1.0.0",
  "private": true,
  "description": "API REST de Biblioteca digital: CRUD, préstamo multi-paso, OAuth 2.0/JWT, RabbitMQ y WebSocket",
  "main": "src/server.js",
  "scripts": {
    "start": "node --require ./src/telemetry.js src/server.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "migrate:seed": "node scripts/migrate.js && node scripts/seed.js",
    "db:reset": "node scripts/reset.js",
    "ws:cliente": "node scripts/ws-client.js",
    "test": "node --test test/"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/api-logs": "0.222.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.222.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-logs": "0.222.0",
    "@opentelemetry/sdk-metrics": "2.11.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "amqplib": "2.0.1",
    "express": "^5.3.0",
    "express-oauth2-jwt-bearer": "1.10.0",
    "jose": "^5.9.6",
    "js-yaml": "^4.1.0",
    "pg": "^8.13.1",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.22.0"
  },
  "engines": {
    "node": ">=22"
  }
}
