    {
      "key": "clientSecret",
      "value": "local-secret",
      "type": "secret",
      "enabled": true
    },
    {
      "key": "lectorClientId",
      "value": "local-lector",
      "type": "default",
      "enabled": true
    },
    {
      "key": "lectorClientSecret",
      "value": "local-secret",
      "type": "secret",
      "enabled": true
    },
    {
      "key": "apiKey",
      "value": "cambiar-esta-api-key",
      "type": "secret",
      "enabled": true
    }
  ]
}
